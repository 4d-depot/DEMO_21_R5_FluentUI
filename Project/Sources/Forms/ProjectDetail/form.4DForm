							},
							"name": "Column1",
							"footer": {
								"name": "Footer1"
							},
							"width": 250,
							"dataSource": "This:C1470.title",
							"maxWidth": 400,
							"minWidth": 250
						},
						{
							"header": {
								"name": "Header3",
								"text": "Assignee",
								"class": "data-grid-header"
							},
							"name": "Column3",
							"footer": {
								"name": "Footer3"
							},
							"dataSource": "This:C1470.assignee",
							"minWidth": 140,
							"width": 140,
							"maxWidth": 400
						},
						{
							"header": {
