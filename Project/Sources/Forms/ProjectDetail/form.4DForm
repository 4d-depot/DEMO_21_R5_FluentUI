					"width": 478,
					"height": 33,
					"max": 100,
					"events": [
						"onDataChange"
					],
					"dataSource": "Form:C1466.progress",
					"graduationStep": 10,
					"labelsPlacement": "bottom",
					"showGraduations": true,
					"sizingX": "grow",
